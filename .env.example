# Copy this file to .env and fill in real values. .env is never committed to Git.
POSTGRES_USER=nile
POSTGRES_PASSWORD=change_me
POSTGRES_DB=weather
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Airflow secrets: any long random text (generate with: [guid]::NewGuid().ToString("N"))
AIRFLOW_JWT_SECRET=change_me
AIRFLOW_SECRET_KEY=change_me
